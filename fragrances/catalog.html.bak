<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Umar's Fragrance Decider</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#0f0f0f;color:#e0e0e0;padding:16px}
h1{font-size:1.3rem;color:#fff;margin-bottom:2px}
.sub{color:#888;font-size:.8rem;margin-bottom:12px}
.stats{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.stat{background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:8px 14px;font-size:.8rem}
.stat-v{font-weight:700;color:#fff;font-size:1.1rem}
.search-bar{width:100%;max-width:350px;padding:8px 12px;background:#1a1a1a;border:1px solid #333;border-radius:6px;color:#fff;font-size:.85rem;margin-bottom:10px;outline:none}
.search-bar:focus{border-color:#6366f1}
.filter-btn{padding:4px 10px;background:#1a1a1a;border:1px solid #333;border-radius:20px;color:#aaa;font-size:.75rem;cursor:pointer}
.filter-btn:hover{border-color:#6366f1;color:#fff}
.filter-btn.active{background:#6366f1;border-color:#6366f1;color:#fff}
.tag{display:inline-block;padding:1px 6px;background:#1e1b4b;color:#a5b4fc;border-radius:10px;font-size:.65rem;margin:1px;white-space:nowrap}
.nt{display:inline-block;padding:1px 5px;background:#1a1a1a;color:#aaa;border-radius:3px;font-size:.68rem;margin:1px}
.tbadge{padding:1px 6px;border-radius:3px;font-size:.68rem;font-weight:600}
.tedp{background:#1e3a5f;color:#93c5fd}
.tedt{background:#1a3a2a;color:#86efac}
.textrait{background:#2a1a3a;color:#e9d5ff}
.tother{background:#2a1a1a;color:#fca5a5}
.lv-bar{height:3px;border-radius:2px;margin-top:3px;width:40px}
.nr{text-align:center;padding:30px;color:#555;font-size:.85rem}
.upd{color:#555;font-size:.7rem;margin-top:12px}

/* Desktop: full table */
table{width:100%;border-collapse:collapse;font-size:.78rem}
th{background:#1a1a1a;color:#888;text-transform:uppercase;font-size:.65rem;letter-spacing:.5px;padding:8px 10px;text-align:left;border-bottom:2px solid #333;position:sticky;top:0;white-space:nowrap}
td{padding:7px 10px;border-bottom:1px solid #1a1a1a;vertical-align:top}
tr:hover td{background:#1a1a1a}
.fname{font-weight:600;color:#fff;white-space:nowrap}
.brand{color:#818cf8}
.tbl-wrap{overflow-x:auto;border-radius:6px;border:1px solid #222}

/* Mobile decider UI */
@media(max-width:768px){
  body{padding:12px}
  h1{font-size:1.1rem;text-align:center}
  .sub{text-align:center}
  .stats{justify-content:center}
  .stat{padding:6px 10px;font-size:.7rem}
  .stat-v{font-size:.95rem}
  
  .mode-switch{display:flex;gap:8px;margin-bottom:12px}
  .mode-btn{flex:1;padding:10px;border:1px solid #333;background:#1a1a1a;color:#ccc;border-radius:12px;font-size:.85rem;cursor:pointer;text-align:center;font-weight:600}
  .mode-btn.active{background:#6366f1;border-color:#6366f1;color:#fff}
  .mode-btn:active{opacity:.7}
  
  .brand-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px}
  .brand-pill{padding:8px 10px;background:#1a1a1a;border:1px solid #333;border-radius:8px;text-align:center;font-size:.78rem;color:#ccc;cursor:pointer}
  .brand-pill:active{opacity:.7}
  .brand-pill .bcnt{color:#6366f1;font-size:.65rem}
  .brand-pill.active{background:#6366f1;border-color:#6366f1;color:#fff}
  .brand-pill.active .bcnt{color:#c7d2fe}
  
  .note-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:12px}
  .note-pill{padding:10px 6px;background:#1a1a1a;border:1px solid #333;border-radius:10px;text-align:center;font-size:.72rem;color:#ccc;cursor:pointer;line-height:1.3}
  .note-pill:active{opacity:.7}
  .note-pill .ncount{color:#888;font-size:.6rem;display:block;margin-top:2px}
  .note-pill.active{background:#6366f1;border-color:#6366f1;color:#fff}
  .note-pill.active .ncount{color:#c7d2fe}

  .mcard{background:#1a1a1a;border:1px solid #333;border-radius:10px;padding:10px 12px;margin-bottom:8px}
  .mcard-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3px}
  .mcard-name{font-weight:600;color:#fff;font-size:.9rem}
  .mcard-brand{color:#818cf8;font-size:.78rem}
  .mcard-meta{display:flex;gap:6px;margin-bottom:4px;flex-wrap:wrap;align-items:center}
  .mcard-notes{margin-top:4px}
  .mcard-note-line{font-size:.72rem;color:#aaa;display:flex;gap:4px;flex-wrap:wrap;margin-top:2px}
  .mcard-note-line .nl{color:#888;width:30px;font-size:.65rem;text-transform:uppercase;flex-shrink:0}
  
  .desktop-only{display:none!important}
  
  .act-badge{display:inline-block;padding:1px 6px;border-radius:3px;font-size:.65rem;font-weight:600}
}

.desktop-only{display:block}
.mobile-only{display:none}

@media(max-width:768px){
  .desktop-only{display:none!important}
  .mobile-only{display:block!important}
}

::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:#1a1a1a}
::-webkit-scrollbar-thumb{background:#444;border-radius:3px}
</style></head><body>
<div class="mobile-only" id="mobileUI">
  <h1>🧴 Fragrance Decider</h1>
  <p class="sub"><span id="cntM">0</span> fragrances</p>
  <input class="search-bar" id="searchM" placeholder="Search name, brand, notes...">
  <div class="mode-switch" id="modeSwitch">
    <div class="mode-btn active" data-mode="brand">🏷️ Brand</div>
    <div class="mode-btn" data-mode="note">🎨 Notes</div>
    <div class="mode-btn" data-mode="layer">🎲 Layer</div>
  </div>
  <div id="mobilePicks"></div>
  <div id="mobileResults"></div>
</div>
<div id="layerCombo" style="display:none"></div>

<div class="desktop-only">
  <h1>🧴 Umar's Fragrance Decider</h1>
  <p class="sub"><span id="cnt">0</span> fragrances</p>
  <div class="stats" id="stats"></div>
  <input class="search-bar" id="search" placeholder="Search fragrances, brands, notes...">
  <div class="filters" id="filters"></div>
  <div class="tbl-wrap"><table><thead><tr><th>Fragrance</th><th>Brand</th><th>Type</th><th>Profile</th><th>Top</th><th>Heart</th><th>Base</th><th>Season</th><th>Longevity</th><th>Sillage</th><th>Tags</th><th>Layer</th></tr></thead><tbody id="tbody"></tbody></table></div>
  <p class="upd" id="upd"></p>
</div>
