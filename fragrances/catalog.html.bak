// Dynamically compute all unique notes from DB
var ALL_NOTES = [];
(function(){
  var seen = {};
  for(var k in DB.fragrances){
    var f = DB.fragrances[k];
    (f.topNotes||[]).concat(f.heartNotes||[]).concat(f.baseNotes||[]).forEach(function(n){
      if(n && !seen[n]){ seen[n]=true; ALL_NOTES.push(n); }
    });
  }
  ALL_NOTES.sort();
})();

var af = new Set();
var ab = new Set();
var ac = new Set();
var mobileMode = 'brand';

function tc(t){if(!t)return 'tother';var x=t.toLowerCase();if(x.indexOf('edp')>=0)return 'tedp';if(x.indexOf('edt')>=0)return 'tedt';if(x.indexOf('extrait')>=0)return 'textrait';return 'tother'}
function lc(l){if(!l)return '#333';var m={'weak':'#ef4444','moderate':'#f59e0b','good':'#22c55e','excellent':'#10b981','strong':'#22c55e','beast':'#6366f1'};return m[l.toLowerCase().trim()]||'#666'}
function allf(){var a=[];for(var k in DB.fragrances)a.push(DB.fragrances[k]);return a}
function isMobile(){return window.innerWidth<=768}

// --- DESKTOP ---
function rt(f){
  var tb=document.getElementById('tbody');
  if(!f.length){tb.innerHTML='<tr><td colspan="12" class="nr">No fragrances found.</td></tr>';return}
  var r=[];
  for(var i=0;i<f.length;i++){
    var g=f[i];var sp=(g.scentProfile||[]).map(function(p){return '<span class="nt">'+p+'</span>'}).join(' ');
    var tn=(g.topNotes||[]).map(function(n){return '<span class="nt">'+n+'</span>'}).join(' ');
    var hn=(g.heartNotes||[]).map(function(n){return '<span class="nt">'+n+'</span>'}).join(' ');
    var bn=(g.baseNotes||[]).map(function(n){return '<span class="nt">'+n+'</span>'}).join(' ');
    var sn=(g.season||[]).map(function(s){return '<span class="nt">'+s+'</span>'}).join(' ');
    var tg=(g.tags||[]).map(function(t){return '<span class="tag">'+t+'</span>'}).join(' ');
    var lon=g.longevity||'';var bar=lon?'<div class="lv-bar" style="background:'+lc(lon)+'"></div>':'';var sil=g.sillage||'';
    var fid = ''; for(var kk in DB.fragrances){ if(DB.fragrances[kk]===g) fid=kk; }
    r.push('<tr><td class="fname">'+(g.name||'')+'</td><td class="brand">'+(g.brand||'')+'</td><td><span class="tbadge '+tc(g.type)+'">'+(g.type||'')+'</span></td><td>'+sp+'</td><td>'+tn+'</td><td>'+hn+'</td><td>'+bn+'</td><td>'+sn+'</td><td>'+lon+bar+'</td><td>'+sil+'</td><td>'+tg+'</td><td><a href="#" onclick="showLayerFit(\''+fid+'\');return false" style="color:#818cf8;font-size:.75rem">🔀 Match</a></td></tr>');
  }
  tb.innerHTML=r.join('');
}
function ft(){
  var q=document.getElementById('search').value.toLowerCase();var a=allf();
  if(q)a=a.filter(function(f){return (f.name+' '+f.brand+' '+f.type+' '+(f.scentProfile||[]).join(' ')+' '+(f.topNotes||[]).join(' ')+' '+(f.heartNotes||[]).join(' ')+' '+(f.baseNotes||[]).join(' ')+' '+(f.tags||[]).join(' ')).toLowerCase().indexOf(q)>=0});
  if(af.size>0)a=a.filter(function(f){var sp=f.scentProfile||[];for(var i=0;i<sp.length;i++){if(af.has(sp[i]))return true}return false});
  if(ab.size>0)a=a.filter(function(f){return f.brand&&ab.has(f.brand)});
  if(ac.size>0)a=a.filter(function(f){
    var sp=(f.scentProfile||[]).map(function(p){return p.toLowerCase().trim()});
    for(var k in NOTE_CATEGORIES){
      if(!ac.has(k)) continue;
      var keywords=NOTE_CATEGORIES[k].map(function(kw){return kw.toLowerCase().trim()});
      for(var i=0;i<sp.length;i++){
        if(keywords.indexOf(sp[i])>=0) return true;
      }
    }
    return false;
  });
  rt(a);
}

// --- MOBILE ---
var selectedCat = '';

// Note-to-category mapping: each broad category matches scentProfile values
var NOTE_CATEGORIES = {
  'Floral': ['Floral','White Floral','Floral Fruity','Rose','Iris','Feminine'],
  'Fresh': ['Citrus','Fresh','Aromatic','Aquatic','Green','Icy','Minty','Soapy','Tea','Clean','Marine','Bright','Citrus-forward','Airy','Zesty','Salty','Summer','Tropical'],
  'Woody': ['Woody','Earthy','Smoky','Leather','Leathery','Oud','Musk','Musky','Metallic','Dry'],
  'Amber/Oriental': ['Amber','Oriental','Warm Spicy','Spicy','Incense','Incense-like','Resinous','Animalic','Tobacco','Boozy','Honey','Nutty','Cinnamon','Chypre','Dark','Warm','Bold'],
  'Gourmand': ['Gourmand','Vanilla','Vanillic','Sweet','Creamy','Powdery','Fruity','Cherry','Smooth']
};

function categoryCount(cat){
  var keywords = NOTE_CATEGORIES[cat] || [cat];
  var c = 0;
  for(var k in DB.fragrances){
    var f = DB.fragrances[k];
    var sp = (f.scentProfile||[]).map(function(p){return p.toLowerCase().trim()});
    for(var i=0;i<sp.length;i++){
      for(var j=0;j<keywords.length;j++){
        if(sp[i] === keywords[j].toLowerCase().trim()){ c++; break; }
      }
      if(c > 0 && c <= 99999) break;
    }
  }
  return c;
}

function getFiltered(){
  var q = document.getElementById('searchM').value.toLowerCase().trim();
  var a = allf();
  if(mobileMode == 'brand' && ab.size > 0){
    a = a.filter(function(f){return f.brand && ab.has(f.brand)});
  }
  if(mobileMode == 'note' && selectedCat){
    var keywords = NOTE_CATEGORIES[selectedCat] || [selectedCat];
    var kLower = keywords.map(function(kw){return kw.toLowerCase().trim()});
    a = a.filter(function(f){
      var sp = (f.scentProfile||[]).map(function(p){return p.toLowerCase().trim()});
      for(var i=0;i<sp.length;i++){
        if(kLower.indexOf(sp[i]) >= 0) return true;
      }
      return false;
    });
  }
  if(q) a = a.filter(function(f){
    return (f.name+' '+f.brand+' '+(f.topNotes||[]).join(' ')+' '+(f.heartNotes||[]).join(' ')+' '+(f.baseNotes||[]).join(' ')+' '+(f.season||[]).join(' ')).toLowerCase().indexOf(q)>=0
  });
  return a;
}

function noteContains(f, noteName){
  var all=(f.topNotes||[]).concat(f.heartNotes||[]).concat(f.baseNotes||[]);
  return all.indexOf(noteName)>=0;
}

function noteWhere(f, noteName){
  var parts=[];
  if((f.topNotes||[]).indexOf(noteName)>=0) parts.push('Top');
  if((f.heartNotes||[]).indexOf(noteName)>=0) parts.push('Heart');
  if((f.baseNotes||[]).indexOf(noteName)>=0) parts.push('Base');
  return parts.join('/');
}

// --- LAYERING ENGINE ---
var LAYER_REASONS = [
  ['fresh','warm','The fresh notes lift the warm base, making it brighter without losing depth.'],
  ['fresh','warm','Crisp freshness cutting through the warmth — balanced and versatile.'],
  ['fresh','sweet','Clean freshness meets sweetness — a crowd-pleasing combo.'],
  ['fresh','sweet','The sweetness sticks while the freshness keeps it airy and light.'],
  ['fresh','dark','Dark and broody lifted by a blast of freshness — unexpected but killer.'],
  ['fresh','dark','The fresh top cuts through the heavy base like a ray of light.'],
  ['warm','sweet','Double warmth. Sweet and warm wrap around each other perfectly. Date night material.'],
  ['warm','sweet','A cozy hug in a bottle. The sweetness amplifies the warmth beautifully.'],
  ['warm','dark','The darkness provides the edge, the warmth makes it approachable. Power combo.'],
  ['warm','dark','Bold and brooding with a warm heart. Gets attention without being offensive.'],
  ['warm','dark','Like a leather jacket with a cashmere lining. Tough outside, cozy within.'],
  ['sweet','dark','Sweetness tames the beast. The dark notes add complexity while the sweetness rounds it out.'],
  ['sweet','dark','The sugar and the smoke dance together — sophisticated but playful.'],
  ['floral','fresh','Florals lifted by fresh air — light, elegant, effortlessly appealing.'],
  ['floral','sweet','A sweet bouquet. The florals bring elegance, the sweetness brings the fun.'],
  ['floral','dark','The florals soften the dark edges. A beautiful beast.'],
  ['spicy','sweet','Spice and sweet are soulmates. The heat makes the sweetness more interesting.'],
  ['spicy','sweet','Like chai with extra honey. Comforting with a kick.'],
  ['spicy','fresh','Fresh with a bite. The spice adds an edge to otherwise clean freshness.'],
  ['spicy','dark','Dark, spicy, and dangerous. Maximum intensity for maximum confidence.'],
  ['spicy','dark','A powerhouse combo. The spice ignites the dark base.'],
  ['fresh','fresh','Two freshies layered — double the clean, double the energy. Perfect for scorching days.'],
  ['sweet','sweet','Double gourmand goodness. For when one sweet scent just isnt enough.'],
];

function getFragProfileFamily(f) {
  var profiles = (f.scentProfile || []).map(function(p){ return p.toLowerCase().trim(); });
  var F = { fresh: ['citrus','fresh','aquatic','aromatic','green','icy','minty','soapy','tea','bright','citrus-forward','clean','marine'],
           warm: ['warm','amber','boozy','warm spicy','honey','nutty','tobacco','cinnamon'],
           sweet: ['sweet','vanilla','gourmand','creamy','powdery','fruity'],
           dark: ['woody','leather','leathery','smoky','oriental','resinous','incense','earthy','animalic','oud'],
           floral: ['floral','floral fruity','white floral'],
           spicy: ['spicy','chypre'] };
  for(var fam in F){
    for(var i=0;i<profiles.length;i++){
      if(F[fam].indexOf(profiles[i]) >= 0) return fam;
    }
  }
  return 'fresh';
}

function isHeavy(f) {
  var lon = (f.longevity||'').toLowerCase();
  var sil = (f.sillage||'').toLowerCase();
  return lon.indexOf('excellent')>=0 || lon.indexOf('beast')>=0 || sil.indexOf('beast')>=0 || sil.indexOf('heavy')>=0 || sil.indexOf('strong')>=0;
}

function generateLayerCombo(){
  var ids = Object.keys(DB.fragrances);
  for(var attempt=0; attempt<80; attempt++){
    var aId = ids[Math.floor(Math.random()*ids.length)];
    var bId = ids[Math.floor(Math.random()*ids.length)];
    if(aId === bId) continue;
    var a = DB.fragrances[aId], b = DB.fragrances[bId];
    var aFam = getFragProfileFamily(a), bFam = getFragProfileFamily(b);
    for(var ri=0; ri<LAYER_REASONS.length; ri++){
      var recipe = LAYER_REASONS[ri];
      if(recipe[0] === aFam && recipe[1] === bFam){
        var aHeavy = isHeavy(a), bHeavy = isHeavy(b);
        if(aHeavy && !bHeavy) return { base: a, top: b, baseId: aId, topId: bId, reason: recipe[2] };
        if(bHeavy && !aHeavy) return { base: b, top: a, baseId: bId, topId: aId, reason: recipe[2] };
        if(Math.random()<0.5) return { base: a, top: b, baseId: aId, topId: bId, reason: recipe[2] };
        else return { base: b, top: a, baseId: bId, topId: aId, reason: recipe[2] };
      }
    }
  }
  var aId = ids[Math.floor(Math.random()*ids.length)];
  var bId = ids[Math.floor(Math.random()*ids.length)];
  return { base: DB.fragrances[aId], top: DB.fragrances[bId], baseId: aId, topId: bId,
    reason: 'An unexpected pairing that just works. Spray the heavier one first, then layer lightly.' };
}

function generateLayerComboFor(fixedId){
  var ids = Object.keys(DB.fragrances);
  var fixed = DB.fragrances[fixedId];
  if(!fixed) return generateLayerCombo();
  var fixedFam = getFragProfileFamily(fixed);
  for(var attempt=0; attempt<80; attempt++){
    var partnerId = ids[Math.floor(Math.random()*ids.length)];
    if(partnerId === fixedId) continue;
    var partner = DB.fragrances[partnerId];
    var partnerFam = getFragProfileFamily(partner);
    for(var ri=0; ri<LAYER_REASONS.length; ri++){
      var recipe = LAYER_REASONS[ri];
      if((recipe[0] === fixedFam && recipe[1] === partnerFam) || (recipe[0] === partnerFam && recipe[1] === fixedFam)){
        var fixedHeavy = isHeavy(fixed), partnerHeavy = isHeavy(partner);
        if(recipe[0] === fixedFam && recipe[1] === partnerFam){
          // Fixed is first in recipe, it's the base
          if(fixedHeavy || !partnerHeavy) return { base: fixed, top: partner, baseId: fixedId, topId: partnerId, reason: recipe[2], locked: fixedId };
        } else {
          // Partner is first in recipe, partner is base
          if(partnerHeavy || !fixedHeavy) return { base: partner, top: fixed, baseId: partnerId, topId: fixedId, reason: recipe[2], locked: fixedId };
        }
        return { base: partner, top: fixed, baseId: partnerId, topId: fixedId, reason: recipe[2], locked: fixedId };
      }
    }
  }
  // Fallback
  var partnerId = ids[Math.floor(Math.random()*ids.length)];
  if(partnerId === fixedId) partnerId = ids[(ids.indexOf(fixedId)+1) % ids.length];
  var partner = DB.fragrances[partnerId];
  var fixedHeavy = isHeavy(fixed);
  if(fixedHeavy) return { base: fixed, top: partner, baseId: fixedId, topId: partnerId, reason: 'These two find a way to work together. Try the heavier one as a base.', locked: fixedId };
  return { base: partner, top: fixed, baseId: partnerId, topId: fixedId, reason: 'Unexpected but interesting. The lighter one sits on top of the heavier base.', locked: fixedId };
}

function showLayerFit(fragId){
  mobileMode = 'layer';
  document.querySelectorAll('.mode-btn').forEach(function(b){
    b.classList.toggle('active', b.dataset.mode === 'layer');
  });
  document.getElementById('layerCombo').style.display = 'block';
  var combo = generateLayerComboFor(fragId);
  var div = document.getElementById('layerCombo');
  var f = DB.fragrances[fragId];
  div.innerHTML = '<div style="background:#1a1a1a;border:1px solid #333;border-radius:10px;padding:12px;margin-bottom:10px">' +
    '<div style="font-size:.85rem;font-weight:700;color:#6366f1;margin-bottom:6px">🎯 Layering Fit for ' + f.name + '</div>' +
    '<div style="margin-bottom:6px"><span style="color:#888;font-size:.7rem">BASE LAYER</span><br><span style="color:#fff;font-weight:600">' + combo.base.name + '</span> <span style="color:#818cf8;font-size:.78rem">' + combo.base.brand + '</span></div>' +
    '<div style="margin-bottom:8px"><span style="color:#888;font-size:.7rem">TOP LAYER</span><br><span style="color:#fff;font-weight:600">' + combo.top.name + '</span> <span style="color:#818cf8;font-size:.78rem">' + combo.top.brand + '</span></div>' +
    '<div style="background:#1e1b4b;color:#c7d2fe;padding:8px 10px;border-radius:8px;font-size:.8rem;margin-bottom:6px">💡 ' + combo.reason + '</div>' +
    '<div style="margin-top:6px;display:flex;gap:6px">' +
      '<button onclick="showLayerFit(\'' + fragId + '\')" style="flex:1;padding:8px;background:#6366f1;border:none;color:#fff;border-radius:8px;font-size:.8rem;font-weight:600;cursor:pointer">🔀 Another Match</button>' +
      '<button onclick="switchMode(\'brand\')" style="flex:1;padding:8px;background:#333;border:none;color:#aaa;border-radius:8px;font-size:.8rem;cursor:pointer">↩ Back</button>' +
    '</div></div>';
}

function renderLayer(){
  document.getElementById('cntM').textContent = '🎲';
  document.getElementById('mobilePicks').innerHTML = '';
  var combo = generateLayerCombo();
  var div = document.getElementById('layerCombo');
  div.style.display = 'block';
  div.innerHTML = '<div style="background:#1a1a1a;border:1px solid #333;border-radius:10px;padding:12px;margin-bottom:10px">' +
    '<div style="font-size:.85rem;font-weight:700;color:#6366f1;margin-bottom:6px">🎲 Shuffle Layering Combo</div>' +
    '<div style="margin-bottom:6px"><span style="color:#888;font-size:.7rem">BASE LAYER</span><br><span style="color:#fff;font-weight:600">' + combo.base.name + '</span> <span style="color:#818cf8;font-size:.78rem">' + combo.base.brand + '</span></div>' +
    '<div style="margin-bottom:8px"><span style="color:#888;font-size:.7rem">TOP LAYER</span><br><span style="color:#fff;font-weight:600">' + combo.top.name + '</span> <span style="color:#818cf8;font-size:.78rem">' + combo.top.brand + '</span></div>' +
    '<div style="background:#1e1b4b;color:#c7d2fe;padding:8px 10px;border-radius:8px;font-size:.8rem;margin-bottom:6px">💡 ' + combo.reason + '</div>' +
    '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">' +
      '<button onclick="renderLayer()" style="flex:1;padding:8px;background:#6366f1;border:none;color:#fff;border-radius:8px;font-size:.8rem;font-weight:600;cursor:pointer">🔀 Shuffle Again</button>' +
    '</div></div>';
}

function renderMobile(){
  document.getElementById('layerCombo').style.display = 'none';
  var a = getFiltered();
  document.getElementById('cntM').textContent = a.length;
  var picksDiv = document.getElementById('mobilePicks');
  var resultsDiv = document.getElementById('mobileResults');
  
  if(mobileMode == 'brand'){
    var bs = new Set();
    allf().forEach(function(f){if(f.brand)bs.add(f.brand)});
    var brands = Array.from(bs).sort(function(a,b){
      return allf().filter(function(f){return f.brand===b}).length - allf().filter(function(f){return f.brand===a}).length;
    });
    var grid = '<div class="brand-grid">';
    brands.forEach(function(b){
      var cnt = allf().filter(function(f){return f.brand===b}).length;
      var active = ab.has(b) ? ' active' : '';
      grid += '<div class="brand-pill'+active+'" onclick="toggleBrand(\''+b.replace(/'/g,"\\'")+'\')">'+b+' <span class="bcnt">'+cnt+'</span></div>';
    });
    grid += '</div>';
    picksDiv.innerHTML = grid;
  } else if(mobileMode == 'note'){
    // Show 5 broad note categories
    var cats = ['Floral','Fresh','Woody','Amber/Oriental','Gourmand'];
    var grid = '<div class="note-grid">';
    cats.forEach(function(c){
      var cnt = categoryCount(c);
      var active = (selectedCat === c) ? ' active' : '';
      grid += '<div class="note-pill'+active+'" onclick="selectCat(\''+c+'\')">'+c+' <span class="ncount">'+cnt+'</span></div>';
    });
    grid += '</div>';
    picksDiv.innerHTML = grid;
  }
  
  if(a.length == 0){
    resultsDiv.innerHTML = '<div class="nr">No fragrances found.</div>';
    return;
  }
  
  var r = '';
  for(var fid in DB.fragrances){
    var g = DB.fragrances[fid];
    if(a.indexOf(g) === -1) continue;
    var tn = (g.topNotes||[]).join(' · ');
    var hn = (g.heartNotes||[]).join(' · ');
    var bn = (g.baseNotes||[]).join(' · ');
    r += '<div class="mcard">'+
      '<div class="mcard-top"><span class="mcard-name">'+(g.name||'')+'</span><span class="mcard-brand">'+(g.brand||'')+'</span></div>'+
      '<div class="mcard-meta"><span class="tbadge '+tc(g.type)+'">'+(g.type||'')+'</span> <span style="font-size:.7rem;color:#888">'+(g.longevity||'')+' '+(g.sillage||'')+'</span></div>'+
      '<div class="mcard-notes">'+
      '<div class="mcard-note-line"><span class="nl">Top</span> '+tn+'</div>'+
      '<div class="mcard-note-line"><span class="nl">Heart</span> '+hn+'</div>'+
      '<div class="mcard-note-line"><span class="nl">Base</span> '+bn+'</div>'+
      '</div>'+
      '<button onclick="showLayerFit(\''+fid+'\')" style="margin-top:6px;padding:6px;width:100%;background:#1e1b4b;border:1px solid #3730a3;color:#a5b4fc;border-radius:8px;font-size:.75rem;cursor:pointer">🔀 Find Layering Match</button>'+
      '</div>';
  };
  resultsDiv.innerHTML = r;
}

function toggleBrand(b){
  if(ab.has(b)) ab.delete(b); else ab.add(b);
  renderMobile();
}

function selectCat(c){
  selectedCat = (selectedCat === c) ? '' : c;
  renderMobile();
}

function switchMode(mode){
  mobileMode = mode;
  ab.clear();
  selectedCat = '';
  document.querySelectorAll('.mode-btn').forEach(function(b){
    b.classList.toggle('active', b.dataset.mode == mode);
  });
  if(mode === 'layer'){
    document.getElementById('layerCombo').style.display = 'block';
    renderLayer();
  } else {
    renderMobile();
  }
}

function initMobile(){
  document.querySelectorAll('.mode-btn').forEach(function(b){
    b.addEventListener('click', function(){switchMode(this.dataset.mode);});
  });
  document.getElementById('searchM').addEventListener('input', function(){
    if(mobileMode === 'layer') switchMode('brand');
    renderMobile();
  });
  renderMobile();
}

function initDesktop(){
  var a=allf();document.getElementById('cnt').textContent=a.length;
  var bs=new Set(), ps=new Set();
  a.forEach(function(f){if(f.brand)bs.add(f.brand);(f.scentProfile||[]).forEach(function(p){ps.add(p)})});
  document.getElementById('stats').innerHTML='<div class="stat"><div class="stat-v">'+a.length+'</div>Frags</div><div class="stat"><div class="stat-v">'+bs.size+'</div>Brands</div><div class="stat"><div class="stat-v">'+ps.size+'</div>Profiles</div>';
  var fe=document.getElementById('filters');
  
  // --- Note Category Filters ---
  var catLabel=document.createElement('div');catLabel.textContent='Category: ';catLabel.style.cssText='color:#888;font-size:.7rem;padding:4px 0;width:100%;margin-top:8px';
  fe.appendChild(catLabel);
  ['Floral','Fresh','Woody','Amber/Oriental','Gourmand'].forEach(function(c){
    var b=document.createElement('button');b.className='filter-btn';b.textContent=c;b.dataset.cat=c;
    b.addEventListener('click',function(){
      if(ac.has(c)){ac.delete(c);b.classList.remove('active')}else{ac.add(c);b.classList.add('active')}
      ft();
    });
    fe.appendChild(b);
  });
  
  // --- Brand Filters ---
  var brandLabel=document.createElement('div');brandLabel.textContent='Brand: ';brandLabel.style.cssText='color:#888;font-size:.7rem;padding:4px 0;width:100%;margin-top:8px';
  fe.appendChild(brandLabel);
  var bsArr=Array.from(bs).sort(function(a,b){return bCount(b)-bCount(a)});
  function bCount(b){return a.filter(function(f){return f.brand===b}).length};
  bsArr.forEach(function(bName){
    var b=document.createElement('button');var bcnt=a.filter(function(f){return f.brand===bName}).length;
    b.className='filter-btn';b.textContent=bName+' ('+bcnt+')';b.dataset.brand=bName;
    b.addEventListener('click',function(){if(ab.has(bName)){ab.delete(bName);b.classList.remove('active')}else{ab.add(bName);b.classList.add('active')}ft();});
    fe.appendChild(b);
  });
  
  // --- Profile Filters ---
  var label2=document.createElement('div');label2.textContent='Profile: ';label2.style.cssText='color:#888;font-size:.7rem;padding:4px 0;width:100%;margin-top:8px';
  fe.appendChild(label2);
  var psArr=Array.from(ps).sort();
  psArr.forEach(function(p){
    var b=document.createElement('button');b.className='filter-btn';b.textContent=p;b.dataset.profile=p;
    b.addEventListener('click',function(){if(af.has(p)){af.delete(p);b.classList.remove('active')}else{af.add(p);b.classList.add('active')}ft();});
    fe.appendChild(b);
  });
  
  // --- Clear All Button ---
  var cb=document.createElement('button');cb.className='filter-btn';cb.textContent='\u2716 clear all filters';
  cb.addEventListener('click',function(){af.clear();ab.clear();ac.clear();document.querySelectorAll('.filter-btn').forEach(function(b){b.classList.remove('active')});document.getElementById('search').value='';ft()});
  fe.appendChild(cb);
  
  rt(a);
  if(DB.meta&&DB.meta.lastUpdated)document.getElementById('upd').textContent='Updated: '+DB.meta.lastUpdated;
}

// --- BOOT ---
if(isMobile()){initMobile()}else{document.getElementById('search').addEventListener('input',ft);initDesktop()}
</script></body></html>
